{
  "name": "storybot-ts",
  "version": "0.1.0",
  "private": true,
  "description": "StoryBot - AI-powered user story processing and document intelligence with LangChain.",
  "type": "module",
  "main": "dist/app.js",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "backend": "npm run stop:backend && npm run start:backend",
    "frontend": "npm run stop:frontend && npm run start:frontend",
    "app": "npm run stop:app && concurrently \"npm run start:backend\" \"npm run start:frontend\" --names \"API,UI\" --prefix name --kill-others-on-fail",
    "start:backend": "tsx watch src/app.ts",
    "start:frontend": "cd client && python3 -m http.server 3000",
    "start:app": "npm run app",
    "stop:backend": "./scripts/port-manager.sh stop-backend",
    "stop:frontend": "./scripts/port-manager.sh stop-frontend", 
    "stop:app": "./scripts/port-manager.sh stop-app",
    "restart:backend": "npm run stop:backend && npm run start:backend",
    "restart:frontend": "npm run stop:frontend && npm run start:frontend",
    "restart:app": "npm run stop:app && npm run app",
    "status": "./scripts/port-manager.sh status",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "ingest:user-stories": "tsx src/pipelines/ingestion/userStoryPipeline.ts",
    "ingest:user-stories:clear": "tsx src/pipelines/ingestion/userStoryPipeline.ts --clear",
    "create-user-story-index": "tsx src/scripts/createUserStoryVectorIndex.ts",
    "verify-user-story-index": "tsx src/scripts/createUserStoryVectorIndex.ts verify"
  },
  "dependencies": {
    "@langchain/anthropic": "^0.3.8",
    "@langchain/community": "^0.3.16",
    "@langchain/core": "^0.3.22",
    "@langchain/groq": "^0.1.3",
    "@langchain/mistralai": "^0.2.1",
    "@langchain/mongodb": "^0.1.0",
    "@langchain/openai": "^0.3.15",
    "@types/multer": "^2.0.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.1",
    "mammoth": "^1.8.0",
    "mongodb": "^6.10.0",
    "multer": "^2.0.2",
    "pdf-parse": "^1.1.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.4",
    "concurrently": "^9.2.1",
    "tsx": "^4.16.2",
    "typescript": "^5.6.3"
  }
}
